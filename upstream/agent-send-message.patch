+      retryAfterMs: PLUGIN_AGENT_MESSAGE_RATE_LIMIT.perMs
+    })
+    expect(chats.send).toHaveBeenCalledTimes(PLUGIN_AGENT_MESSAGE_RATE_LIMIT.maxMessages)
+
+    vi.setSystemTime(1_000_000 + PLUGIN_AGENT_MESSAGE_RATE_LIMIT.perMs + 1)
