+++ b/src/main/plugins/workers/host-api/plugin-agent-message-budget.ts
@@ -0,0 +1,38 @@
+import { PLUGIN_AGENT_MESSAGE_RATE_LIMIT } from '../../../../shared/plugins/workers/plugin-host-api-agent-chat'
+import {
+  createPanelMessageBudget,
+  type PanelMessageBudget
+} from '../../../../shared/plugins/frames/plugin-panel-message-budget'
+
+/**
+ * `agent.sendMessage`'s budget: one sliding window per plugin, across every chat. Why per plugin:
+ * each message starts an agent turn with the person's tools, so a looping worker must stall fast.
+ * The window counts calls, not bytes; params validation already bounds the text.
+ */
+const budgets = new Map<string, PanelMessageBudget>()
+
+/** Null when the plugin may send now; otherwise how long until its window admits another. */
+export function admitPluginAgentMessage(pluginId: string, now: number = Date.now()): number | null {
+  let budget = budgets.get(pluginId)
+  if (!budget) {
+    budget = createPanelMessageBudget({
+      maxBytes: Number.POSITIVE_INFINITY,
+      maxMessages: PLUGIN_AGENT_MESSAGE_RATE_LIMIT.maxMessages,
+      perMs: PLUGIN_AGENT_MESSAGE_RATE_LIMIT.perMs
+    })
+    budgets.set(pluginId, budget)
+  }
+  if (budget.admit(now, 0) !== 'rate_limited') {
+    return null
+  }
+  return budget.retryAfterMs?.(now) ?? PLUGIN_AGENT_MESSAGE_RATE_LIMIT.perMs
+}
+
+/** Forgets one plugin's window, or every plugin's. */
+export function clearPluginAgentMessageBudgets(pluginId?: string): void {
+  if (pluginId === undefined) {
+    budgets.clear()
+  } else {
+    budgets.delete(pluginId)
+  }
+}
diff --git a/src/main/plugins/workers/host-api/plugin-host-agent-chat-bindings.ts b/src/main/plugins/workers/host-api/plugin-host-agent-chat-bindings.ts
new file mode 100644
index 00000000..5487f75d
--- /dev/null
+++ b/src/main/plugins/workers/host-api/plugin-host-agent-chat-bindings.ts
@@ -0,0 +1,116 @@
+import { PLUGIN_HOST_API } from '../../../../shared/plugins/workers/plugin-host-api'
+import { PLUGIN_HOOK_SPECS } from '../../../../shared/plugins/events/plugin-hook-payloads'
+import { structuredAgentSessionStatusPaneKey } from '../../../../shared/agent-session/view/structured-agent-session-tab'
+import { PluginHookDeniedError, runPluginHook } from '../../hooks/plugin-hook-dispatch'
+import { bind, type BoundPluginHostMethod } from './plugin-host-method-bind'
+import { PluginHostCallError } from './plugin-host-call-scope'
+import type { PluginHostServices } from './plugin-host-method-bindings'
+import type { PluginAgentChat, PluginAgentChatService } from './plugin-agent-chat-service'
+import { admitPluginAgentMessage } from './plugin-agent-message-budget'
+
+const api = PLUGIN_HOST_API
+
+export const NO_CHAT_REFUSAL = 'no Orca chat has this id'
+const GROUP_CHAT_REFUSAL = 'a group chat takes messages only through its group conversation'
+const HOOK_REWRITE_REFUSAL = 'a plugin hook rewrote the message into one Orca cannot send'
+const AGENT_MAX = 128
+const OPTION_VALUE_MAX = 256
+
+function chats(services: PluginHostServices): PluginAgentChatService {
+  if (!services.agentChats) {
+    throw new PluginHostCallError('unavailable', "this Orca host cannot reach Orca's chats")
+  }
+  return services.agentChats
+}
+
+/** The chat this Orca's chat host holds under the id; a paired server's chats are not held here. */
+async function requireChat(
+  service: PluginAgentChatService,
+  chatSessionId: string
+): Promise<PluginAgentChat> {
+  // Why: a group chat's audience and provenance belong to its group (as `agentSession.send` refuses).
+  if (chatSessionId.startsWith('bot-group-')) {
+    throw new PluginHostCallError('action_failed', GROUP_CHAT_REFUSAL)
+  }
+  const chat = await service.find(chatSessionId)
+  if (!chat) {
+    throw new PluginHostCallError('action_failed', NO_CHAT_REFUSAL)
+  }
+  return chat
+}
+
+/**
+ * `agent.prompt.before`, as for a prompt Orca submits to a terminal agent: plugins may rewrite the
+ * message or deny it. `terminalId` is the chat's pane key (what `agent.status.changed` names it).
+ */
+async function hookedMessage(chat: PluginAgentChat, text: string): Promise<string> {
+  let prompt: string
+  try {
+    const hooked = await runPluginHook(
+      'agent.prompt.before',
+      PLUGIN_HOOK_SPECS['agent.prompt.before'].payload,
+      {
+        agent: chat.agent.slice(0, 64) || null,
+        terminalId: structuredAgentSessionStatusPaneKey(chat.chatSessionId),
+        prompt: text,
+        inputKind: 'driving',
+        chatSessionId: chat.chatSessionId
+      }
+    )
+    prompt = hooked.prompt
+  } catch (error) {
+    if (error instanceof PluginHookDeniedError) {
+      // The guard's reason reaches the caller; `denied_by_plugin` is no host API code.
+      throw new PluginHostCallError('action_failed', error.message)
+    }
+    throw error
+  }
+  // A rewrite must still be a message this method accepts.
+  if (prompt !== text && !api['agent.sendMessage'].params.shape.text.safeParse(prompt).success) {
+    throw new PluginHostCallError('action_failed', HOOK_REWRITE_REFUSAL)
+  }
+  return prompt
+}
+
+function optionValue(value: string | null): string | null {
+  return value ? value.slice(0, OPTION_VALUE_MAX) : null
+}
+
+export const PLUGIN_AGENT_CHAT_HANDLERS = {
+  'agent.sendMessage': bind(
+    api['agent.sendMessage'],
+    async ({ chatSessionId, text, delivery }, ctx) => {
+      const service = chats(ctx.services)
+      // Charged before any lookup, so a loop over unknown ids stalls too.
+      const retryAfterMs = admitPluginAgentMessage(ctx.pluginId)
+      if (retryAfterMs !== null) {
+        throw new PluginHostCallError(
+          'rate_limited',
+          'too many chat messages from this plugin; try again later',
+          retryAfterMs
+        )
+      }
+      const chat = await requireChat(service, chatSessionId)
+      const message = await hookedMessage(chat, text)
+      // A hook may have taken seconds: the plugin may have lost approval meanwhile.
+      ctx.scope.assertActive()
+      return service.send({
+        pluginKey: ctx.pluginId,
+        chatSessionId,
+        text: message,
+        delivery: delivery ?? 'queue',
+        beforeRun: () => ctx.scope.assertActive()
+      })
+    }
+  ),
+  'agent.readOptions': bind(api['agent.readOptions'], async ({ chatSessionId }, { services }) => {
+    const service = chats(services)
+    const chat = await requireChat(service, chatSessionId)
+    const { model, effort } = await service.readOptions(chatSessionId)
+    return {
+      agent: chat.agent.slice(0, AGENT_MAX),
+      model: optionValue(model),
+      effort: optionValue(effort)
+    }
+  })
+} satisfies Record<string, BoundPluginHostMethod>
