+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { PluginCapabilityKind } from '../../../../shared/plugins/capabilities/plugin-capabilities'
+import { PLUGIN_AGENT_MESSAGE_RATE_LIMIT } from '../../../../shared/plugins/workers/plugin-host-api-agent-chat'
+import { structuredAgentSessionStatusPaneKey } from '../../../../shared/agent-session/view/structured-agent-session-tab'
+import { executePluginHostCall } from './plugin-host-methods'
+import { callPluginHost, pluginHostTestServices } from './__mocks__/plugin-host-services-fixture'
+import { setPluginHookRunner } from '../../hooks/plugin-hook-dispatch'
+import { clearPluginAgentMessageBudgets } from './plugin-agent-message-budget'
+import { NO_CHAT_REFUSAL } from './plugin-host-agent-chat-bindings'
+import { pluginHostCallRevoked } from './plugin-host-call-scope'
+import type { PluginAgentChatService } from './plugin-agent-chat-service'
+import type { PluginHostServices } from './plugin-host-method-bindings'
+
+const CHAT = 'chat_0123456789abcdef'
+
+function chatService(overrides: Partial<PluginAgentChatService> = {}) {
+  return {
+    find: vi.fn<PluginAgentChatService['find']>(async (chatSessionId) =>
+      chatSessionId === CHAT ? { chatSessionId, agent: 'claude' } : null
+    ),
+    send: vi.fn<PluginAgentChatService['send']>(async () => ({ status: 'sent' as const })),
+    readOptions: vi.fn<PluginAgentChatService['readOptions']>(async () => ({
+      model: 'opus',
+      effort: 'high'
+    })),
+    ...overrides
+  }
+}
+
+const sendMessage = (
+  params: unknown,
+  agentChats: PluginAgentChatService | null,
