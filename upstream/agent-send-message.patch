+const CHAT = 'chat_0123456789abcdef'
+
+type Options = { model?: string; effort?: string }
+
+function fakeHost(record: { provider: string; currentFence: number } | null = null) {
+  const getConversation = vi.fn((id: string) =>
+    id === CHAT ? (record ?? { provider: 'claude', currentFence: 7 }) : undefined
+  )
+  const readOptions = vi.fn(
+    async (_sessionId: string): Promise<{ models: unknown[]; current: Options }> => ({
+      models: [],
+      current: { model: 'gpt-5.5', effort: 'high' }
+    })
+  )
+  // oxlint-disable-next-line typescript/consistent-type-assertions -- SAFETY: the service reads only these members.
+  const host = {
+    deps: { store: { getConversation } },
+    send: vi.fn(),
+    waitForSendSettlement: vi.fn(),
+    readOptions
+  } as unknown as PluginChatHost
+  return { host, getConversation, readOptions }
+}
+
+const send = {
+  pluginKey: 'acme.flow',
+  chatSessionId: CHAT,
+  text: 'Ship it',
+  delivery: 'queue' as const,
+  beforeRun: () => undefined
+}
+
+beforeEach(() => {
+  sendAgentTurn.mockReset()
+})
+
+describe('pluginAgentChats', () => {
+  it('finds a chat the chat host holds, with its agent', async () => {
+    const { host } = fakeHost()
+    const chats = pluginAgentChats({ ensureStructuredAgentSessionHost: vi.fn() }, () => host)
+
+    await expect(chats.find(CHAT)).resolves.toEqual({ chatSessionId: CHAT, agent: 'claude' })
+    await expect(chats.find('chat_other_00000')).resolves.toBeNull()
+  })
+
+  it('installs the chat host on first use', async () => {
+    const { host } = fakeHost()
+    let installed: PluginChatHost | null = null
+    const ensureStructuredAgentSessionHost = vi.fn(async () => {
+      installed = host
+    })
+    const chats = pluginAgentChats({ ensureStructuredAgentSessionHost }, () => installed)
+
+    await expect(chats.find(CHAT)).resolves.toMatchObject({ agent: 'claude' })
+    expect(ensureStructuredAgentSessionHost).toHaveBeenCalledTimes(1)
+  })
+
+  it('is unavailable when the chat host cannot start', async () => {
+    const chats = pluginAgentChats(
+      { ensureStructuredAgentSessionHost: vi.fn().mockRejectedValue(new Error('db locked')) },
+      () => null
+    )
+
+    const failure = await chats.find(CHAT).catch((error: unknown) => error)
+
+    expect(failure).toBeInstanceOf(PluginHostCallError)
+    expect(failure).toMatchObject({ code: 'unavailable', detail: 'db locked' })
+  })
+
+  it("sends as the plugin's own caller, at the chat's current fence, with no sender label", async () => {
+    const { host } = fakeHost({ provider: 'codex', currentFence: 12 })
+    sendAgentTurn.mockResolvedValue({ kind: 'sent', clientMessageId: 'm1', submission: undefined })
+    const chats = pluginAgentChats({ ensureStructuredAgentSessionHost: vi.fn() }, () => host)
+
+    await expect(chats.send({ ...send, delivery: 'now' })).resolves.toEqual({ status: 'sent' })
+
+    expect(sendAgentTurn).toHaveBeenCalledWith({
+      kind: 'structured-session',
+      host,
+      sessionId: CHAT,
+      callerKey: pluginAgentChatCallerKey('acme.flow'),
+      budgetMs: 0,
+      turn: {
+        body: { kind: 'message', role: 'user', blocks: [{ type: 'text', text: 'Ship it' }] },
+        operationId: expect.stringMatching(/^\d{13}-[0-9a-f]{32}$/),
+        expectedRuntimeFence: 12,
+        delivery: 'now',
+        beforeRun: send.beforeRun
+      }
+    })
+  })
+
+  it('reports a message a busy chat holds as queued', async () => {
+    const { host } = fakeHost()
+    sendAgentTurn.mockResolvedValue({ kind: 'queued', clientMessageId: 'm1', queued: {} })
+    const chats = pluginAgentChats({ ensureStructuredAgentSessionHost: vi.fn() }, () => host)
+
+    await expect(chats.send(send)).resolves.toEqual({ status: 'queued' })
+  })
+
+  it('fails with a fixed message when the chat refuses, keeping the reason for the log', async () => {
+    const { host } = fakeHost()
+    sendAgentTurn.mockResolvedValue({
+      kind: 'refused',
+      refusal: { code: 'agent_session_fence_stale', message: 'stale fence' }
+    })
+    const chats = pluginAgentChats({ ensureStructuredAgentSessionHost: vi.fn() }, () => host)
+
+    const failure = await chats.send(send).catch((error: unknown) => error)
+
+    expect(failure).toMatchObject({
+      code: 'action_failed',
+      message: 'the chat did not take the message',
+      detail: 'agent_session_fence_stale: stale fence'
+    })
+  })
+
+  it('fails when the agent rejected the message', async () => {
+    const { host } = fakeHost()
+    sendAgentTurn.mockResolvedValue({
+      kind: 'sent',
+      clientMessageId: 'm1',
+      submission: { dispatchState: 'rejected' }
+    })
+    const chats = pluginAgentChats({ ensureStructuredAgentSessionHost: vi.fn() }, () => host)
+
+    await expect(chats.send(send)).rejects.toMatchObject({ code: 'action_failed' })
+  })
+
+  it('refuses a chat that disappeared before the send', async () => {
+    const { host } = fakeHost()
+    const chats = pluginAgentChats({ ensureStructuredAgentSessionHost: vi.fn() }, () => host)
+
+    await expect(chats.send({ ...send, chatSessionId: 'chat_gone_000000' })).rejects.toMatchObject({
+      code: 'action_failed'
+    })
+    expect(sendAgentTurn).not.toHaveBeenCalled()
+  })
+
+  it("reads the next turn's model and effort", async () => {
+    const { host, readOptions } = fakeHost()
+    const chats = pluginAgentChats({ ensureStructuredAgentSessionHost: vi.fn() }, () => host)
+
+    await expect(chats.readOptions(CHAT)).resolves.toEqual({ model: 'gpt-5.5', effort: 'high' })
+    expect(readOptions).toHaveBeenCalledWith(CHAT)
+
+    readOptions.mockResolvedValueOnce({ models: [], current: { model: '', effort: undefined } })
+    await expect(chats.readOptions(CHAT)).resolves.toEqual({ model: null, effort: null })
+  })
+})
