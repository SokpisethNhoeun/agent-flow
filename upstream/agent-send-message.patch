diff --git a/src/shared/plugins/workers/plugin-host-api-agent-chat.ts b/src/shared/plugins/workers/plugin-host-api-agent-chat.ts
new file mode 100644
index 00000000..08ecb64d
--- /dev/null
+++ b/src/shared/plugins/workers/plugin-host-api-agent-chat.ts
@@ -0,0 +1,72 @@
+import { z } from 'zod'
+import { pluginChatSessionIdSchema } from './plugin-chat-session-id'
+import { ALL_SURFACES, spec, WORKER_ONLY } from './plugin-host-method-spec'
+
+/** Host API 1.11: Orca's own chat sessions (native chat), by the `chatSessionId` agent rows give. */
+
+/** Longer than a terminal prompt: a chat message is often a pasted plan or review. Far below the
+ *  chat host's own 256 KiB message bound. */
+export const PLUGIN_AGENT_MESSAGE_MAX_LENGTH = 32 * 1024
+/** Per plugin, across every chat: a dashboard sends on a person's click, never in a loop. */
+export const PLUGIN_AGENT_MESSAGE_RATE_LIMIT = { maxMessages: 10, perMs: 60_000 } as const
+const OPTION_VALUE_MAX = 256
+
+const agentSendMessageParams = z.strictObject({
+  /** The chat, as `agents.list` and `agent.status.changed` give its `chatSessionId`. */
+  chatSessionId: pluginChatSessionIdSchema,
+  /** Sent as the chat's next message, as if typed in its composer; no attachments or skills. */
+  text: z
+    .string()
+    .min(1)
+    .max(PLUGIN_AGENT_MESSAGE_MAX_LENGTH)
+    .refine((text) => text.trim().length > 0, 'text must not be blank'),
+  /** `queue` (default): a busy chat holds it as a queued message, sent when its turn ends, as
+   *  a person's send does. `now`: a busy chat takes it into the running turn. */
+  delivery: z.enum(['queue', 'now']).optional()
+})
+const agentSendMessageResult = z.object({
+  /** `sent`: the chat took it as its next turn (or into the running one, for `now`); `queued`:
+   *  the chat was busy and holds it until its turn ends. Neither says the agent answered. */
+  status: z.enum(['sent', 'queued'])
+})
+
+const agentReadOptionsParams = z.strictObject({
+  /** The chat, as `agents.list` and `agent.status.changed` give its `chatSessionId`. */
+  chatSessionId: pluginChatSessionIdSchema
+})
+const agentReadOptionsResult = z.object({
+  /** Which agent runs the chat (`claude`, `codex`, ...). */
+  agent: z.string().max(128),
+  /** The model the chat's next turn uses, by the agent's own id; null when the agent reports
+   *  none and nothing was picked. */
+  model: z.string().max(OPTION_VALUE_MAX).nullable(),
+  /** The reasoning effort the next turn uses (`low`, `high`, ...); null when the agent or model
+   *  has none. */
+  effort: z.string().max(OPTION_VALUE_MAX).nullable()
+})
+
+export const PLUGIN_AGENT_CHAT_API = {
+  'agent.sendMessage': spec({
+    summary:
+      "Sends a message to one of Orca's agent chats (native chat, not a terminal), named by the `chatSessionId` `agents.list` and `agent.status.changed` give; it shows in the chat as a message the person sent. Only chats this Orca's own chat host holds; a paired Orca server's chats are refused with `action_failed`. Plugins' `agent.prompt.before` hooks run first and may rewrite or deny it. At most 10 messages a minute per plugin, then `rate_limited`.",
+    since: 11,
+    scope: 'any-workspace',
+    capability: 'agent:message',
+    mutation: true,
+    // Why worker only: a message runs the agent with the person's tools and permissions.
+    surfaces: WORKER_ONLY,
+    params: agentSendMessageParams,
+    result: agentSendMessageResult
+  }),
+  'agent.readOptions': spec({
+    summary:
+      "The agent, model and reasoning effort one of Orca's agent chats uses for its next turn, named by its `chatSessionId`; what its model picker shows.",
+    since: 11,
+    scope: 'any-workspace',
+    capability: 'agent:read',
+    mutation: false,
+    surfaces: ALL_SURFACES,
+    params: agentReadOptionsParams,
+    result: agentReadOptionsResult
+  })
+}
