diff --git a/src/shared/plugins/workers/plugin-chat-session-id.ts b/src/shared/plugins/workers/plugin-chat-session-id.ts
new file mode 100644
index 00000000..35f3f07b
--- /dev/null
+++ b/src/shared/plugins/workers/plugin-chat-session-id.ts
@@ -0,0 +1,13 @@
+import { z } from 'zod'
+
+/**
+ * An Orca chat session's id, as `agents.list` and `agent.status.changed` give it in
+ * `chatSessionId`. Same shape as the chat host's own session ids (`agent-session-record`), kept
+ * here so the plugin schemas do not import the chat record module. Not the agent's own session id
+ * (`sessionId`), which `agent.resume` takes.
+ */
+export const PLUGIN_CHAT_SESSION_ID_PATTERN = /^[A-Za-z0-9_-]{8,128}$/
+
+export const pluginChatSessionIdSchema = z
+  .string()
+  .regex(PLUGIN_CHAT_SESSION_ID_PATTERN, 'invalid chat session id')
