--- /dev/null
+++ b/src/main/plugins/workers/host-api/plugin-agent-chat-service.ts
@@ -0,0 +1,32 @@
+/**
+ * Orca's own chat sessions (native chat) as the plugin host reaches them: structural, so the host
+ * method bindings stay electron-free and tests can pass a fake. Main binds the chat host behind it
+ * (`plugin-agent-chats.ts`); absent where no chat host runs.
+ */
+
+/** One chat this Orca's chat host holds. */
+export type PluginAgentChat = {
+  chatSessionId: string
+  /** The chat's agent (`claude`, `codex`, ...), as its record names it. */
+  agent: string
+}
+
+export type PluginAgentChatSend = {
+  /** The calling plugin's qualified key: scopes the chat host's operation ledger to it. */
+  pluginKey: string
+  chatSessionId: string
+  /** Already through `agent.prompt.before`. */
+  text: string
+  delivery: 'queue' | 'now'
+  /** Runs synchronously when the chat host admits the message; a throw refuses it. */
+  beforeRun: () => void
+}
+
+export type PluginAgentChatService = {
+  /** Null when this Orca's chat host holds no chat with this id. */
+  find(chatSessionId: string): Promise<PluginAgentChat | null>
+  /** Rejects with a PluginHostCallError the plugin may see when the chat does not take it. */
+  send(input: PluginAgentChatSend): Promise<{ status: 'sent' | 'queued' }>
+  /** The next turn's model and effort; null for one the chat has none of. */
+  readOptions(chatSessionId: string): Promise<{ model: string | null; effort: string | null }>
+}
diff --git a/src/main/plugins/workers/host-api/plugin-agent-message-budget.ts b/src/main/plugins/workers/host-api/plugin-agent-message-budget.ts
