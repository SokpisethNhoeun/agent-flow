@@ -0,0 +1,101 @@
+import { randomUUID } from 'node:crypto'
+import { getStructuredAgentSessionHost } from '../../native-chat/agent-session-wire/host/structured-agent-session-registry'
+import type { StructuredAgentSessionHost } from '../../native-chat/agent-session-wire/host/structured-agent-session-host'
+import { sendAgentTurn } from '../../runtime/orchestration/turn-delivery/send-agent-turn'
+import { structuredAgentSessionSendBody } from '../../../shared/agent-session/requests/structured-agent-session-send-mutation'
+import { createStructuredAgentSessionOperationId } from '../../../shared/agent-session/lifecycle/operations/structured-agent-session-mutation'
+import { PluginHostCallError } from '../workers/host-api/plugin-host-call-scope'
+import type { PluginAgentChatService } from '../workers/host-api/plugin-agent-chat-service'
+
+/** What a plugin's chat message reads of the chat host. */
+export type PluginChatHost = Pick<
+  StructuredAgentSessionHost,
+  'send' | 'waitForSendSettlement' | 'readOptions' | 'deps'
+>
+
+const CHATS_UNAVAILABLE = "Orca's chats are not available now"
+
+/** Each plugin's own operation ledger on the chat host, beside connectors' and orchestration's. */
+export function pluginAgentChatCallerKey(pluginKey: string): string {
+  return `trusted-local:plugin:${pluginKey}`
+}
+
+function failureDetail(error: unknown): string {
+  return error instanceof Error ? error.message : String(error)
+}
+
+/**
+ * The plugin host's view of this Orca's chat host, which installs on first use. A message is sent
+ * as automations and connectors send theirs (`sendAgentTurn`): a new operation id per call, the
+ * chat's current fence, and no sender label, so it shows as a message the person sent. Admission
+ * is the receipt; how the turn goes is the chat's to show.
+ */
+export function pluginAgentChats(
+  runtime: { ensureStructuredAgentSessionHost(): Promise<void> },
+  readHost: () => PluginChatHost | null = getStructuredAgentSessionHost
+): PluginAgentChatService {
+  const chatHost = async (): Promise<PluginChatHost> => {
+    const installed = readHost()
+    if (installed) {
+      return installed
+    }
+    try {
+      await runtime.ensureStructuredAgentSessionHost()
+    } catch (error) {
+      throw new PluginHostCallError('unavailable', CHATS_UNAVAILABLE, undefined, failureDetail(error))
+    }
+    const ready = readHost()
+    if (!ready) {
+      throw new PluginHostCallError('unavailable', CHATS_UNAVAILABLE)
+    }
+    return ready
+  }
+  return {
+    async find(chatSessionId) {
+      const record = (await chatHost()).deps.store.getConversation(chatSessionId)
+      return record ? { chatSessionId, agent: record.provider } : null
+    },
+    async send({ pluginKey, chatSessionId, text, delivery, beforeRun }) {
+      const host = await chatHost()
+      // Read again: the fence moves when the chat restarts, and a stale one is refused.
+      const record = host.deps.store.getConversation(chatSessionId)
+      if (!record) {
+        throw new PluginHostCallError('action_failed', 'no Orca chat has this id')
+      }
+      const outcome = await sendAgentTurn({
+        kind: 'structured-session',
+        host,
+        sessionId: chatSessionId,
+        callerKey: pluginAgentChatCallerKey(pluginKey),
+        budgetMs: 0,
+        turn: {
+          body: structuredAgentSessionSendBody(text, []),
+          operationId: createStructuredAgentSessionOperationId(randomUUID),
+          expectedRuntimeFence: record.currentFence,
+          delivery,
+          beforeRun
+        }
+      })
+      switch (outcome.kind) {
+        case 'refused':
+          throw new PluginHostCallError(
+            'action_failed',
+            'the chat did not take the message',
+            undefined,
+            `${outcome.refusal.code}: ${outcome.refusal.message}`
+          )
+        case 'queued':
+          return { status: 'queued' }
+        case 'sent':
+          if (outcome.submission?.dispatchState === 'rejected') {
+            throw new PluginHostCallError('action_failed', 'the agent could not take the message')
+          }
+          return { status: 'sent' }
+      }
+    },
+    async readOptions(chatSessionId) {
+      const { current } = await (await chatHost()).readOptions(chatSessionId)
+      return { model: current.model || null, effort: current.effort || null }
+    }
+  }
+}
