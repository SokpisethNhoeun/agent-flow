+        chatSessionId: CHAT,
+        text: 'Review the diff',
+        delivery: 'queue'
+      })
+    )
+    // The audit log names the chat and the size, never the message.
+    expect(record).toHaveBeenCalledWith(
+      expect.objectContaining({
+        actor: 'plugin:samples.demo',
+        method: 'agent.sendMessage',
+        summary: `chat=${CHAT} chars=15 delivery=queue`,
+        outcome: 'attempt'
+      })
