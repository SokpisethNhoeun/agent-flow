{
  "name": "agent-flow",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "n8n-style live visual multi-agent orchestration view for Orca",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build && orca plugin validate .",
    "test:ui": "node scripts/ui-walkthrough.mjs",
    "test:ui:fixture": "npm run build && node --import tsx scripts/ui-walkthrough-fixture.ts",
    "check:all": "npm run typecheck && npm test && npm run test:ui:fixture && npm run test:ui"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.15.37",
    "@assistant-ui/react-markdown": "^0.14.26",
    "@dagrejs/dagre": "^1.1.8",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@xyflow/react": "^12.12.1",
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
